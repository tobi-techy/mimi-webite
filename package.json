{
  "name": "mimi-website",
  "version": "1.0.0",
  "private": true,
  "description": "Mimi marketing website (Next.js App Router).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:export": "STATIC_EXPORT=1 next build",
    "build:console": "node scripts/build-console.mjs",
    "build:console-demo": "NEXT_PUBLIC_MIMI_MODE=demo node scripts/build-console.mjs",
    "build:console-live": "NEXT_PUBLIC_MIMI_MODE=live node scripts/build-console.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:console": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning src/features/console/api/mappers.test.ts src/features/console/lib/safe-href.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:svg": "svgo --config svgo.config.cjs -f assets-src/brand -o public/brand",
    "encode:video": "sh scripts/encode-hero-video.sh",
    "og:banners": "node scripts/render-share-banners.mjs",
    "knip": "npx -y knip@5"
  },
  "dependencies": {
    "cuelume": "^0.2.8",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "svgo": "^3.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
