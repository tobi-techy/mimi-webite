# Public site URL, used for canonical links, Open Graph images, sitemap and robots.
# Set this to the real domain before launch (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://userail.money

# Address shown on the site and used by every mailto link and the form fallback.
NEXT_PUBLIC_CONTACT_EMAIL=tobilobaomotade@userail.money

# WhatsApp number in international format, digits only, e.g. 2348012345678.
# Leave empty to hide the floating WhatsApp button and the contact page WhatsApp button.
NEXT_PUBLIC_WHATSAPP=

# Optional form endpoint (Formspree, Tally, your API). When set, the contact form POSTs JSON here.
# When empty (or if the request fails) the form opens the visitor's email app instead.
NEXT_PUBLIC_FORM_ENDPOINT=
